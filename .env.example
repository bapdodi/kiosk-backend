# 복사해서 .env 로 사용: cp .env.example .env
SERVER_PORT=8093

# Postgres
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/kiosk
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=password

# ERP (MSSQL) — 로컬 전용 강한 비밀번호로 교체할 것
ERP_DATASOURCE_URL=jdbc:sqlserver://localhost:1433;databaseName=DR_ERP;trustServerCertificate=true
ERP_DATASOURCE_USERNAME=sa
ERP_DATASOURCE_PASSWORD=change-me-strong-password
MSSQL_SA_PASSWORD=change-me-strong-password

DOCKER_USERNAME=local

# ───────────────────────────────────────────────────────────────────────────
# 업로드 이미지 저장소 (MinIO / S3 호환)
# 객체 키 = 파일명, 서빙 URL 은 /uploads/<파일명> (백엔드가 MinIO 에서 프록시)
# ───────────────────────────────────────────────────────────────────────────
MINIO_ENDPOINT=http://192.168.0.90:9000
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=kiosk
# 1회성 마이그레이션 시에만 설정(예: /app/uploads). 완료 후 비우고 재배포.
MINIO_MIGRATE_LOCAL_DIR=

# ───────────────────────────────────────────────────────────────────────────
# 네이버 커머스API(스마트스토어) 연동
# 1) 커머스API센터(apicenter.commerce.naver.com)에서 애플리케이션 등록 후 발급
#    - 권한 그룹: 상품(Product), 판매자정보(Seller) 포함
#    - 호출 IP 등록 필수(백엔드 서버 공인 IP)
# 2) 출고지/반품지 주소록 no 는 스마트스토어센터 배송정보에서 확인해 채운다.
#    (스마트스토어센터에 배송지/반품지를 미리 등록해 두어야 함)
# ───────────────────────────────────────────────────────────────────────────
NAVER_COMMERCE_CLIENT_ID=
NAVER_COMMERCE_CLIENT_SECRET=
NAVER_COMMERCE_BASE_URL=https://api.commerce.naver.com/external
NAVER_SHIPPING_ADDRESS_ID=
NAVER_RETURN_ADDRESS_ID=
NAVER_AS_TELEPHONE=
NAVER_ORIGIN_AREA_CODE=
# 검색품질(브랜드/제조사). 비우면 네이버 검색품질 체크에서 '입력 안됨'(빨간불)으로 뜬다.
# 브랜드는 보통 스토어(상점) 이름, 제조사는 무브랜드/자체제작이면 '자체제작'으로 둔다.
NAVER_BRAND_NAME=기타
NAVER_MANUFACTURER_NAME=기타
# 택배사 코드(네이버 배송사 코드). 예: 로젠택배=KGB, CJ대한통운=CJGLS. 택배 배송상품 필수.
NAVER_DELIVERY_COMPANY=
NAVER_DELIVERY_BASE_FEE=4000
NAVER_RETURN_DELIVERY_FEE=4000
NAVER_EXCHANGE_DELIVERY_FEE=8000
# 신규 등록 후 곧바로 판매중지(초안) 처리 여부. 검수 후 수동으로 판매중 전환.
NAVER_REGISTER_AS_SUSPENDED=true
